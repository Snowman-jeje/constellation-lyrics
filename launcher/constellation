#!/usr/bin/env bash
# Constellation Lyrics Launcher
# Automatically restarts backend with latest updates and brings up the fullscreen visualizer.

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PORT=9876
URL="http://127.0.0.1:${PORT}"

# Stop any older backend instance so fresh code and palette extractor run
pkill -f "constellation-lyrics/backend/app.py" 2>/dev/null || true
sleep 0.3

echo "🚀 Starting Constellation Lyrics backend..."
python3 "${DIR}/backend/app.py" > /dev/null 2>&1 &

for i in {1..30}; do
  if curl -s "${URL}/api/status" > /dev/null 2>&1; then
    break
  fi
  sleep 0.1
done

# Launch native GTK/WebKit window if available, fallback to browser
if python3 -c "import gi; gi.require_version('WebKit2', '4.1')" > /dev/null 2>&1; then
  python3 "${DIR}/launcher/window.py" "${URL}"
elif which firefox > /dev/null 2>&1; then
  firefox --new-window "${URL}"
else
  xdg-open "${URL}"
fi
